---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ReviewCards from '../components/ReviewCards.astro';
import FaqList from '../components/FaqList.astro';
import PostCards from '../components/PostCards.astro';
import { business, promo, primaryCtaHref, workPhotos, faqSchema } from '../data/site';

const years = new Date().getFullYear() - business.foundingYear;

const reasons = [
  { icon: 'home', title: 'Family owned', text: `A small team protecting LA homes since ${business.foundingYear}. You'll see the same technicians visit after visit.` },
  { icon: 'shield', title: '100% satisfaction guarantee', text: "If pests come back between scheduled visits, we come back too — at no charge." },
  { icon: 'paw', title: 'Family & pet friendly', text: "EPA-registered products, applied carefully, with clear instructions for kids and pets before we start." },
  { icon: 'certificate', title: 'Licensed & insured', text: `Licensed by the California Structural Pest Control Board (Reg. ${business.spcbRegistration}) and fully insured.` },
  { icon: 'chat', title: 'Fast, real replies', text: 'Text us and a real person replies — usually within minutes during business hours.' },
  { icon: 'badge', title: 'Honest recommendations', text: "We tell you what you need — and what you don't. No upselling, no scare tactics." },
];

const pests = ['Ants', 'Cockroaches', 'Spiders', 'Rats & Mice', 'Mosquitoes', 'Termites', 'Fleas', 'Wasps', 'Silverfish', 'Earwigs', 'Crickets', 'Ticks'];

const faqs = [
  { q: 'Do you handle rodent problems like mice and rats?', a: 'Yes. Our rodent control service includes a free inspection, trapping and bait stations, entry-point identification, exclusion recommendations, and follow-up visits. Rodents can carry disease and cause serious property damage — we take it seriously.' },
  { q: 'How soon can you schedule a visit?', a: 'In most cases we can schedule your first treatment within 24–48 hours. We serve the Greater Los Angeles area and work around your schedule.' },
  { q: 'Do you treat during the winter months?', a: "Yes. Pests don't take the winter off, and neither do we. Cockroaches, rodents, and spiders often move indoors when it cools down, so year-round protection is the best approach." },
  { q: 'What is your satisfaction guarantee?', a: "If you see pests between scheduled treatments, contact us and we'll come back for a free re-treatment." },
  { q: 'How much does pest control cost?', a: 'General pest control starts at $50/month, Premium pest control at $70/month, and mosquito control at $120/month. Rodent and termite services start with a free inspection, and we give you a firm quote before any work begins. Your exact price depends on your home and the pest problem.' },
  { q: 'Are your treatments safe for pets and children?', a: "We use EPA-registered products and apply them responsibly. We'll tell you about any brief re-entry times before we start, and our technicians are trained to minimize exposure for your family and pets." },
];
---

<Layout title="Professional Pest Control — Los Angeles" schema={[faqSchema(faqs)]}>

  <!-- HERO -->
  <section class="px-3 sm:px-4 pt-3">
    <div class="relative overflow-hidden rounded-[2rem] min-h-[640px] md:min-h-[720px] flex items-end" style="background-image:url('/photos/home-hero.jpg');background-size:cover;background-position:center 35%;">
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/10"></div>
      <div class="relative container-site w-full pb-12 md:pb-16 pt-32 grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-7">
          <p class="inline-flex items-center gap-2 bg-white/15 backdrop-blur text-white text-sm font-semibold px-4 py-2 rounded-full mb-6">
            <span class="text-yellow-300">★★★★★</span> {business.rating} on Google · Family owned since {business.foundingYear}
          </p>
          <h1 class="h-display text-white text-5xl md:text-7xl">Los Angeles Pest Control</h1>
          <p class="text-white/90 text-lg md:text-xl mt-6 max-w-xl leading-relaxed">
            We protect your home, your family, and your pets from pests — with honest service and a 100% satisfaction guarantee.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href={primaryCtaHref} class="btn-light !py-4 !px-8 text-lg">Protect My Home</a>
            <a href={business.phoneHref} class="btn-ghost-light !py-4 !px-8 text-lg">Call {business.phone}</a>
          </div>
        </div>

        {promo.active && (
          <div class="lg:col-span-5 lg:justify-self-end w-full max-w-md">
            <div class="bg-white rounded-3xl p-7 shadow-2xl">
              <p class="inline-block bg-yellow-300 text-brand-dark text-xs font-extrabold uppercase tracking-widest px-3 py-1 rounded-full mb-4">{promo.eyebrow}</p>
              <p class="text-3xl font-extrabold text-brand-dark leading-tight mb-2">{promo.headline}</p>
              <p class="text-gray-600 mb-5">Text <strong class="text-brand-dark">{promo.code}</strong> to <strong class="text-brand-dark">{business.phone}</strong> to claim it.</p>
              <a href={primaryCtaHref} class="btn-primary w-full !py-4">Text “{promo.code}” Now</a>
              <p class="text-xs text-gray-500 mt-3 text-center">{promo.terms}</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="px-4 py-10 border-b border-gray-100">
    <div class="container-site grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div><p class="text-4xl font-extrabold text-brand-dark">{years}+</p><p class="text-sm text-gray-500 font-semibold">Years serving LA</p></div>
      <div><p class="text-4xl font-extrabold text-brand-dark">{business.rating} ★</p><p class="text-sm text-gray-500 font-semibold">Google rating</p></div>
      <div><p class="text-4xl font-extrabold text-brand-dark">40+</p><p class="text-sm text-gray-500 font-semibold">Pest types treated</p></div>
      <div><p class="text-4xl font-extrabold text-brand-dark">100%</p><p class="text-sm text-gray-500 font-semibold">Satisfaction guarantee</p></div>
    </div>
  </section>

  <ServiceCards heading="Explore our wide range of services" />

  <!-- WHY CHOOSE US -->
  <section class="py-20 px-4">
    <div class="container-site grid lg:grid-cols-2 gap-12 items-center">
      <div class="relative">
        <img src="/photos/why-us.jpg" alt="Lion Gate technician placing a rodent bait station" class="w-full aspect-[4/5] object-cover rounded-[2rem]" loading="lazy" />
        <div class="absolute -bottom-6 -right-2 sm:right-6 bg-white rounded-2xl shadow-xl p-5 max-w-[15rem]">
          <p class="text-3xl font-extrabold text-brand-dark">Since {business.foundingYear}</p>
          <p class="text-sm text-gray-600">Protecting Los Angeles homes and families.</p>
        </div>
      </div>
      <div>
        <p class="eyebrow mb-3">Why choose us?</p>
        <h2 class="h-section mb-8">A pest control team you can actually trust.</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          {reasons.map((r) => (
            <div>
              <div class="w-12 h-12 rounded-2xl bg-brand-light text-brand-medium flex items-center justify-center mb-3"><Icon name={r.icon} /></div>
              <h3 class="font-extrabold text-brand-dark mb-1">{r.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">{r.text}</p>
            </div>
          ))}
        </div>
        <a href="/about/" class="btn-outline mt-10">More about us</a>
      </div>
    </div>
  </section>

  <!-- RECENT WORK -->
  {workPhotos.length > 0 && (
    <section class="py-20 px-4 bg-brand-light">
      <div class="container-site">
        <div class="text-center mb-12">
          <p class="eyebrow mb-3">On the job</p>
          <h2 class="h-section">Check out some of our recent work</h2>
        </div>
        <div class="grid gap-4 grid-cols-2 md:grid-cols-3">
          {workPhotos.map((p, i) => (
            <img src={p.src} alt={p.alt} loading="lazy" class={`w-full h-full object-cover rounded-3xl aspect-square ${i === 0 ? 'col-span-2 md:col-span-1' : ''}`} />
          ))}
        </div>
      </div>
    </section>
  )}

  <ProcessSteps />

  <ReviewCards />

  <!-- PESTS WE TREAT -->
  <section class="py-16 px-4 bg-brand-light">
    <div class="container-site text-center">
      <p class="eyebrow mb-3">40+ pests covered</p>
      <h2 class="h-section mb-8">Pests we eliminate</h2>
      <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
        {pests.map((p) => <span class="bg-white rounded-full px-5 py-2.5 font-semibold text-brand-dark border border-gray-200">{p}</span>)}
      </div>
      <a href="/common-pests/" class="btn-primary mt-10">See common LA pests</a>
    </div>
  </section>

  <FaqList faqs={faqs} />

  <PostCards limit={3} />

</Layout>
