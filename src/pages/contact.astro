---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { business, promo, primaryCtaHref, cities, cityHref } from '../data/site';

const methods = [
  { icon: 'chat', title: 'Text us', value: business.phone, href: primaryCtaHref, note: 'Fastest — we usually reply within minutes during business hours' },
  { icon: 'phone', title: 'Call us', value: business.phone, href: business.phoneHref, note: business.hours },
  { icon: 'mail', title: 'Email us', value: business.email, href: `mailto:${business.email}`, note: 'We reply within one business day' },
];
---

<Layout title="Contact Us" description="Contact Lion Gate Pest Control — Los Angeles pest and rodent control. Call or text (818) 353-4800. Serving the Greater Los Angeles area.">

  <PageHero
    eyebrow="Get in touch"
    title="Contact Us"
    subtitle="Ready to get rid of pests? Reach out and we'll get you scheduled fast."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
    ctas={false}
  />

  <section class="py-20 px-4">
    <div class="container-site grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="h-section mb-8">How to reach us</h2>
        <div class="space-y-4">
          {methods.map((m) => (
            <a href={m.href} class="card p-6 flex items-start gap-5 hover:shadow-lg transition-shadow">
              <span class="w-14 h-14 flex-shrink-0 rounded-2xl bg-brand-light text-brand-medium flex items-center justify-center"><Icon name={m.icon} class="w-7 h-7" /></span>
              <span>
                <span class="block text-sm font-bold uppercase tracking-wider text-gray-500">{m.title}</span>
                <span class="block text-xl font-extrabold text-brand-dark break-all">{m.value}</span>
                <span class="block text-sm text-gray-600 mt-1">{m.note}</span>
              </span>
            </a>
          ))}
        </div>

        <div class="card p-6 mt-4 bg-brand-light border-none">
          <h3 class="font-extrabold text-brand-dark mb-2">Business hours</h3>
          <p class="text-gray-700">Monday – Friday: 9am – 5pm<br />Saturday – Sunday: Closed</p>
        </div>

        {promo.active && (
          <div class="mt-8">
            <a href={primaryCtaHref} class="btn-primary-lg w-full">Text “{promo.code}” — {promo.headline}</a>
            <p class="text-gray-500 text-sm text-center mt-3">{promo.terms}</p>
          </div>
        )}
      </div>

      <div>
        <h2 class="h-section mb-8">Service area</h2>
        <div class="rounded-[2rem] overflow-hidden border border-gray-200">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d211282.36557258!2d-118.60467!3d34.20!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c2955a67654d2b%3A0x4fa3eb4c23c2db1a!2sSan%20Fernando%20Valley%2C%20CA!5e0!3m2!1sen!2sus!4v1"
            width="100%" height="380" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
            title="Lion Gate Pest Control service area map"
          ></iframe>
        </div>
        <h3 class="font-extrabold text-brand-dark mt-8 mb-4">Cities we serve</h3>
        <div class="flex flex-wrap gap-2">
          {cities.map((c) => <a href={cityHref(c)} class="rounded-full border border-gray-200 px-4 py-2 text-sm font-semibold text-brand-dark hover:bg-brand-light">{c.name}</a>)}
        </div>
        <p class="text-gray-600 mt-6">Don't see your city? Give us a call — we may still service your area.</p>
      </div>
    </div>
  </section>

</Layout>
