---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { business } from '../data/site';

const reviews = [
  {
    name: 'Verified Google Review',
    location: 'Los Angeles, CA',
    text: 'I have been with this company for years. I had a very bad ant problem — once I started pest control with every other month service, we have not had any ants. Tom and Rick are great, they are honest. What I like about Lion Gate is they not only do pest, they also do termites and rodent work. I highly recommend Lion Gate.',
    rating: 5,
  },
  {
    name: 'Verified Google Review',
    location: 'Los Angeles, CA',
    text: 'Lion Gate has been treating our house for over 20 years. Our relatives use Lion Gate too. Very happy with them.',
    rating: 5,
  },
  {
    name: 'Verified Google Review',
    location: 'Los Angeles, CA',
    text: "It's been a year we are working with Lion Gate and they are doing a great job with great price. Tom was very friendly and did a great job today. I'm happy with the service.",
    rating: 5,
  },
  {
    name: 'Verified Google Review',
    location: 'Los Angeles, CA',
    text: 'Absolutely amazing service. Came in, discovered the problem, got it all done diligently. They explained all about what they use and how it will work. Answered any and all questions and were an absolute delight to correspond with. Would give a 10/10 if I could. Can\'t go wrong with Lions Gate.',
    rating: 5,
  },
  {
    name: 'Verified Google Review',
    location: 'Los Angeles, CA',
    text: 'New owner, Tom, provides the same excellent service as the previous owner. Very helpful and answered all my questions. Very satisfied.',
    rating: 5,
  },
  {
    name: 'Verified Google Review',
    location: 'Los Angeles, CA',
    text: 'We have been using Lion Gate for years and they are very nice, professional and great to work with!',
    rating: 5,
  },
];
---

<Layout title="Customer Reviews" description="See what Los Angeles homeowners say about Lion Gate Pest Control. Hundreds of satisfied customers across the Greater Los Angeles area.">

  <PageHero
    eyebrow={`${business.rating} ★ · ${business.reviewCount} Google reviews`}
    title="Customer Reviews"
    subtitle="Don't take our word for it — hear from your neighbors across Los Angeles."
    image="/photos/truck.jpg"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Reviews' }]}
  />

  <section class="py-20 px-4">
    <div class="container-site">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {reviews.map(review => (
          <figure class="card p-8 flex flex-col">
            <div class="text-yellow-400 text-xl mb-4" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote class="text-gray-700 leading-relaxed flex-1">“{review.text}”</blockquote>
            <figcaption class="mt-6 pt-4 border-t border-gray-100">
              <p class="font-bold text-brand-dark text-sm">{review.name}</p>
              <p class="text-gray-500 text-xs mt-1">{review.location}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="mt-14 rounded-[2rem] bg-brand-light p-10 text-center max-w-3xl mx-auto">
        <div class="w-14 h-14 rounded-2xl bg-white text-yellow-500 flex items-center justify-center mx-auto mb-4"><Icon name="star" class="w-8 h-8" /></div>
        <h2 class="text-2xl md:text-3xl font-extrabold text-brand-dark mb-3">See all {business.reviewCount} reviews on Google</h2>
        <p class="text-gray-600 mb-6">We have a {business.rating} rating on Google. Read every review from your neighbors across Los Angeles.</p>
        <a href="https://share.google/156d9QWu5Z7cPsNIA" target="_blank" rel="noopener noreferrer" class="btn-primary">Read our Google reviews →</a>
      </div>
    </div>
  </section>

  <section class="py-16 px-4 bg-brand-dark diagonal-stripe">
    <div class="container-site grid grid-cols-2 md:grid-cols-4 gap-8 text-center text-white">
      <div><p class="text-4xl font-extrabold">100%</p><p class="text-green-200 text-sm font-semibold mt-1">Satisfaction guarantee</p></div>
      <div><p class="text-4xl font-extrabold">40+</p><p class="text-green-200 text-sm font-semibold mt-1">Pest types treated</p></div>
      <div><p class="text-4xl font-extrabold">{business.reviewCount}</p><p class="text-green-200 text-sm font-semibold mt-1">Five-star Google reviews</p></div>
      <div><p class="text-4xl font-extrabold">{new Date().getFullYear() - business.foundingYear}+</p><p class="text-green-200 text-sm font-semibold mt-1">Years serving LA</p></div>
    </div>
  </section>

</Layout>
