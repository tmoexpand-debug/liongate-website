---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PriceBadge from '../components/PriceBadge.astro';
import ServiceIncluded from '../components/ServiceIncluded.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FaqList from '../components/FaqList.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { services, cities, faqSchema, serviceSchema, smsHref } from '../data/site';

const included = [
  'Mice (all species)',
  'Rats (Norway & Roof Rats)',
  'Full home inspection',
  'Bait station placement',
  'Snap trap installation',
  'Entry point identification',
  'Exclusion recommendations',
  'Attic & crawl space inspection',
  'Garage & outbuilding assessment',
  'Follow-up monitoring visits',
];

const excluded = [
  'Dead rodent removal (available as add-on)',
  'Squirrels & wildlife',
  'Insulation replacement (available as add-on)',
];

const risks = [
  { icon: 'pulse', title: 'Health risk', text: 'Rodents carry hantavirus, salmonella, and other pathogens that contaminate surfaces and food.' },
  { icon: 'zap', title: 'Fire hazard', text: 'Rodents gnaw on electrical wiring, which can start house fires.' },
  { icon: 'home', title: 'Property damage', text: 'They chew through insulation, pipes, and building materials, causing costly damage over time.' },
];

const signs = [
  { icon: 'dots', sign: 'Droppings near food, in cabinets, or along walls' },
  { icon: 'sound', sign: 'Scratching or scurrying sounds in walls or attic' },
  { icon: 'gnaw', sign: 'Gnaw marks on food packaging, wires, or wood' },
  { icon: 'wind', sign: 'Musty or ammonia-like odor from hidden areas' },
  { icon: 'nest', sign: 'Nesting material like shredded paper or insulation' },
  { icon: 'paw', sign: 'Tracks or grease marks along baseboards' },
];

const steps = [
  { title: 'Free inspection', text: 'We inspect your attic, crawl space, garage, and exterior to find activity, nesting areas, and every way rodents are getting in.' },
  { title: 'Remove & exclude', text: 'We set traps and bait stations where they will work, and give you clear exclusion recommendations to seal entry points.' },
  { title: 'Monitor', text: 'Follow-up visits check and reset traps and stations until activity stops — and make sure no new rodents move in.' },
];

const faqs = [
  { q: 'Is the rodent inspection really free?', a: "Yes. We inspect your home, show you what we find, and give you a quote. There's no charge and no obligation." },
  { q: 'How long does it take to get rid of rats?', a: 'Most homes see activity drop within the first couple of weeks. Lasting results depend on sealing entry points, which is why exclusion is part of our program.' },
  { q: 'Do you use poison inside my home?', a: 'Inside the home we primarily use traps. Bait stations are tamper-resistant and placed outside, away from kids and pets.' },
  { q: 'Do you remove dead rodents?', a: 'Dead rodent removal is available as an add-on service. Ask us when you book.' },
];

const service = services.find((s) => s.slug === 'rodent-control')!;
---

<Layout title="Rodent Control Services" description="Professional rodent control in Los Angeles. We eliminate mice and rats with bait stations, trapping, and exclusion. 100% satisfaction guarantee." image="/rodent-control-hero.jpg" schema={[serviceSchema(service, cities.map((c) => c.name)), faqSchema(faqs)]}>

  <PageHero
    eyebrow="Los Angeles Rodent Specialists"
    title="Rodent Control"
    subtitle="Mice and rats are more than a nuisance — they carry disease, chew wiring, and contaminate food. Our rodent control program eliminates the problem at its source and keeps them from coming back."
    image="/rodent-control-hero.jpg"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: 'Rodent Control' }]}
  >
    <PriceBadge slug="rodent-control" />
  </PageHero>

  <section class="py-16 px-4">
    <div class="container-site grid gap-6 md:grid-cols-3">
      {risks.map((r) => (
        <div class="card p-8">
          <div class="w-12 h-12 rounded-2xl bg-brand-light text-brand-medium flex items-center justify-center mb-4"><Icon name={r.icon} /></div>
          <h2 class="text-lg font-extrabold text-brand-dark mb-2">{r.title}</h2>
          <p class="text-gray-600 text-sm leading-relaxed">{r.text}</p>
        </div>
      ))}
    </div>
  </section>

  <ServiceIncluded
    included={included}
    includedTitle="We cover"
    excluded={excluded}
    note={{ title: 'Combo plans available', text: 'Combine rodent control with general pest control for complete home protection at the best value.', linkText: 'Ask about combo plans', href: smsHref("Hi, I'd like to ask about a pest + rodent combo plan") }}
  />

  <section class="py-20 px-4 bg-brand-light">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">Don't wait</p>
        <h2 class="h-section">Signs you have rodents</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {signs.map((s) => (
          <div class="card p-5 flex items-center gap-4">
            <span class="w-12 h-12 rounded-2xl bg-brand-light text-brand-medium flex items-center justify-center flex-shrink-0"><Icon name={s.icon} /></span>
            <p class="font-semibold text-gray-700">{s.sign}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={smsHref("Hi, I'd like a free rodent inspection")} class="btn-primary-lg">Book a Free Rodent Inspection</a>
      </div>
    </div>
  </section>

  <ProcessSteps heading="How our rodent program works" steps={steps} />

  <FaqList faqs={faqs} heading="Rodent control questions" />

  <ServiceCards exclude="rodent-control" heading="Explore our other services" />
</Layout>
