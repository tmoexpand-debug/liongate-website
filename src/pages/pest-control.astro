---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import PriceBadge from '../components/PriceBadge.astro';
import ServiceIncluded from '../components/ServiceIncluded.astro';
import PestActivityChart from '../components/PestActivityChart.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FaqList from '../components/FaqList.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { services, cities, faqSchema, serviceSchema, smsHref, promo } from '../data/site';

const included = [
  'Ants (all species)', 'Cockroaches', 'Spiders', 'Fleas', 'Flies & Gnats', 'Wasps & Hornets',
  'Beetles', 'Silverfish', 'Earwigs', 'Centipedes & Millipedes', 'Stink Bugs', 'Crickets',
  'Aphids', 'Box Elder Bugs', 'Pill Bugs', 'Ticks',
];

const excluded = [
  'Termites (separate service)',
  'Mosquito yard treatments (separate service)',
  'Bed Bugs (specialized treatment available)',
  'Wildlife removal',
  'Structural damage repair',
];

const schedule = [
  { season: 'Spring', focus: 'Ant colonies, wasp nest prevention, perimeter barrier' },
  { season: 'Summer', focus: 'Flies, hornets, and heat-driven ant invasions' },
  { season: 'Fall', focus: 'Indoor pest-proofing, spiders, crickets entering the home' },
  { season: 'Winter', focus: 'Cockroaches and interior treatments' },
];

const steps = [
  { title: 'Inspection', text: 'Our technician inspects interior and exterior areas to find pest activity, entry points, and conditions that attract pests.' },
  { title: 'Treatment', text: 'We apply EPA-registered products to targeted areas — the perimeter, entry points, nesting areas, and high-activity zones — using methods suited to homes with kids and pets.' },
  { title: 'Follow-up & monitoring', text: "Recurring visits maintain your protection. If pests return between visits, we come back at no charge — that's our guarantee." },
];

const faqs = [
  { q: 'How often is general pest control service?', a: "Most homes do best on a recurring schedule. We'll recommend a visit frequency based on your home, your yard, and the pests you're seeing." },
  { q: 'Do you treat inside the house?', a: 'Yes. Your first visit includes interior and exterior treatment. Recurring visits focus on the exterior barrier, and we treat inside anytime you need it.' },
  { q: 'What happens if I still see bugs after treatment?', a: "It's normal to see some activity for a few days as pests come into contact with the treatment. If you're still seeing pests after that, or between visits, contact us and we'll come back free." },
  { q: 'Is general pest control safe for my pets?', a: "We use EPA-registered products and apply them responsibly. We'll let you know about any brief dry time before pets go back into treated areas." },
];

const service = services.find((s) => s.slug === 'pest-control')!;
const plans = services.filter((s) => s.slug.endsWith('pest-control'));
---

<Layout title="Pest Control Services in Los Angeles, CA" description="Professional pest control services in Los Angeles. We treat 40+ pests including ants, cockroaches, spiders, wasps, and more. 100% satisfaction guarantee." image="/photos/pest-control.jpg" schema={[serviceSchema(service, cities.map((c) => c.name)), faqSchema(faqs)]}>

  <PageHero
    eyebrow="Los Angeles Pest Control"
    title="Pest Control"
    subtitle="Comprehensive pest management for Los Angeles homeowners. We eliminate the bugs and keep them away with regular service and a free re-treatment guarantee."
    image="/photos/pest-control.jpg"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: 'Pest Control' }]}
  >
    <PriceBadge slug="pest-control" />
  </PageHero>

  <section id="plans" class="py-20 px-4 bg-brand-light scroll-mt-24">
    <div class="container-site">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">Choose your plan</p>
        <h2 class="h-section">General or Premium?</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 max-w-4xl mx-auto">
        {plans.map((p, i) => (
          <div class={`card p-8 md:p-10 flex flex-col ${i === 1 ? 'ring-2 ring-brand-medium' : ''}`}>
            <h3 class="text-2xl font-extrabold text-brand-dark">{p.name}</h3>
            <p class="text-gray-500 mb-6">{p.tagline}</p>
            <p class="text-xs font-bold uppercase tracking-wider text-gray-500">{p.price.label}</p>
            <p class="text-5xl font-extrabold text-brand-dark mb-6">{p.price.amount}<span class="text-xl font-bold text-gray-500">{p.price.unit}</span></p>
            <p class="text-gray-600 mb-6">{p.summary}</p>
            <ul class="space-y-2 mb-8 flex-1">
              {p.features.map((f) => <li class="flex gap-2"><span class="text-brand-medium font-bold">✓</span>{f}</li>)}
            </ul>
            <a href={smsHref(promo.active ? promo.code : `Hi, I'd like ${p.name}`)} class="btn-primary w-full">Get Started</a>
          </div>
        ))}
      </div>
      <p class="text-center text-gray-600 mt-10 max-w-2xl mx-auto">
        In the east Valley, read the neighborhood guide to
        <a href="/pest-control/burbank/" class="font-bold text-brand-medium hover:text-brand-dark">pest control in Burbank</a>.
      </p>
    </div>
  </section>

  <ServiceIncluded
    included={included}
    excluded={excluded}
    note={{ title: 'Custom treatments available', text: 'Have a specific pest problem not listed? We offer custom treatment plans for bed bugs and other specialty pests.', linkText: 'Ask about custom plans', href: smsHref("Hi, I'd like to ask about a custom treatment plan") }}
  />

  <section class="py-20 px-4 bg-brand-light">
    <div class="container-site">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">Results</p>
        <h2 class="h-section">What happens after treatment</h2>
        <p class="lead mt-4 max-w-2xl mx-auto">Pest activity drops sharply after your first visit and stays low with regular service.</p>
      </div>
      <PestActivityChart />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mt-10">
        {schedule.map((s) => (
          <div class="card p-6">
            <h3 class="font-extrabold text-brand-dark mb-1">{s.season}</h3>
            <p class="text-sm text-gray-600">{s.focus}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProcessSteps heading="Our treatment process" steps={steps} />

  <FaqList faqs={faqs} heading="Pest control questions" />

  <ServiceCards exclude={['pest-control', 'premium-pest-control']} heading="Explore our other services" />
</Layout>
