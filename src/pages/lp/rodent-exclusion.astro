---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Icon from '../../components/Icon.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import { cities as serviceAreas } from '../../data/site';

// Cities the ?city= token may render. Same two zones as the ant campaign
// (East Valley + the Pasadena arm), plus the broader names for catch-all ad groups.
const cities = [
  'Pasadena', 'Altadena', 'Sierra Madre', 'Arcadia', 'Duarte', 'Alhambra',
  'Burbank', 'Glendale', 'Sun Valley', 'Tujunga', 'La Crescenta', 'La Cañada',
  'Los Angeles',
];
// The default page speaks to the whole service area; ?city= is only for an ad group
// aimed at one city.
const defaultCity = 'Greater Los Angeles';

// Quo sales line: calls and texts land in the inbox the team already answers.
const PHONE = '+16269983292';
const PHONE_DISPLAY = '(626) 998-3292';

const smsTemplate =
  "Hi Lion Gate - I'd like a free rodent exclusion inspection.";

// Server-rendered fallback for the in-page CTAs. The layout script rewrites every
// [data-sms] href with the resolved ?city= value, but the buttons must already be
// tappable before that runs — an href="#" CTA is a dead button if JS fails.
const defaultSmsHref = `sms:${PHONE}?&body=${encodeURIComponent(smsTemplate.replace('{city}', defaultCity))}`;

// Every review below is verbatim — real Google reviews, not written for this page.
const reviews = [
  {
    text: 'Lion Gate Pest Control is a great company. The people are very friendly and knowledgeable. Rick took the time to show me the problem areas, explain the treatment process and educate me on how to mitigate future issues. He explained everything in a way that was easy to understand. He gave me a heads up when he was on his way and was on-time for the confirmed appointment window. I was impressed with how thorough the inspection was (attic, garage, shed, and under the house). The treatment was affordable and effective. If you want the job done well you should specifically request Rick as your inspector/technician.',
    source: 'Verified Google Review',
  },
  {
    text: "Absolutely amazing service. Came in, discovered the problem, got it all done diligently. They explained all about what they use and how it will work. Answered any and all questions and were an absolute delight to correspond with. Would give a 10/10 if I could. Can't go wrong with Lions Gate.",
    source: 'Verified Google Review',
  },
  {
    text: 'I have been with this company for years. I had a very bad ant problem — once I started pest control with every other month service, we have not had any ants. Tom and Rick are great, they are honest. What I like about Lion Gate is they not only do pest, they also do termites and rodent work. I highly recommend Lion Gate.',
    source: 'Verified Google Review',
  },
];

// Per-city prose. Only the cities we're actually advertising in get their own
// entry — the rest fall back to defaultCopy rather than getting invented local
// detail. Add a city here when it gets its own ad group, not before.
const cityCopy = {
  Pasadena: {
    localTexture:
      "Pasadena's older homes are some of the easiest in LA for rodents to get into. Craftsman bungalows and pre-war houses sit on raised foundations, and a single torn crawl-space vent screen gives rats the whole sub-area. Mature trees put limbs on the roofline, and roof rats use them to reach attic vents.",
    serviceArea:
      'Serving Bungalow Heaven, Madison Heights, San Rafael, Hastings Ranch and the rest of Pasadena.',
  },
  Burbank: {
    localTexture:
      "In Burbank, the homes backing onto the Verdugos take the most rodent pressure — the open hillside above is a reservoir of rats and mice that moves downhill every fall. On the flats, roof rats travel the power lines and backyard fruit trees from house to house.",
    serviceArea:
      'Serving Magnolia Park, the Rancho, Burbank Hills, Chandler and the rest of Burbank.',
  },
};

// Used for every other city, and rendered server-side so the page reads correctly
// before the city script runs.
const defaultCopy = {
  localTexture:
    "Around Los Angeles, most of the rats we find in attics are roof rats. They live in palms, ivy and fruit trees, run the power lines and fences, and get onto the roof from an overhanging limb. Once they are up there, a gap the size of a quarter is enough to get inside.",
  serviceArea: `Serving ${serviceAreas.map((c) => c.name).join(', ')} and nearby communities.`,
};

const entryPoints = [
  { icon: 'home', text: 'Torn or missing crawl-space vent screens' },
  { icon: 'wrench', text: 'Gaps around plumbing, gas and A/C line penetrations' },
  { icon: 'wind', text: 'Roof returns, eave gaps and attic vents' },
  { icon: 'truck', text: 'Garage door corners and worn weather seals' },
  { icon: 'zap', text: 'Openings where the roofline meets the chimney' },
  { icon: 'leaf', text: 'Tree limbs and vines touching the roof' },
];

const included = [
  {
    icon: 'certificate',
    title: 'Free top-to-bottom inspection',
    body: 'Attic, crawl space, garage and the full exterior. We find the activity, the nesting areas, and every opening they are using — and show you what we find.',
  },
  {
    icon: 'shield',
    title: 'Exclusion: we seal them out',
    body: 'We close the openings into the home, attic and crawl space with durable materials rodents cannot chew through. This is the step that makes the problem stop for good.',
  },
  {
    icon: 'rodent',
    title: 'Exterior bait stations',
    body: 'Tamper-resistant stations placed outside, around the perimeter, to knock down the population before it reaches the house. No poison inside your home.',
  },
  {
    icon: 'clock',
    title: 'Interior trapping & follow-up',
    body: 'Once the house is sealed, we set traps inside for the rodents already in, then keep coming back to check them for up to 60 days, until activity stops.',
  },
];

const years = new Date().getFullYear() - 2005;

const steps = [
  { title: 'Text us', text: "Tell us what you're hearing or seeing. A real person here usually replies within a few minutes during business hours to set up your free inspection." },
  { title: 'Free inspection & quote', text: 'We go through the attic, crawl space, garage and exterior, show you every entry point we find, and give you a straight price to seal it. No charge, no obligation.' },
  { title: 'Seal, remove, monitor', text: 'We seal the openings, place exterior bait stations, and trap the rodents left inside. Our 60-day guarantee means we keep trapping until activity stops.' },
];
---

<LandingLayout
  title="Rodent Exclusion | Lion Gate Pest Control"
  description="Rodent exclusion that seals rats and mice out of your attic, crawl space and walls. Free inspection. Family owned since 2005, 5.0 stars on Google. Text for a free inspection."
  cities={cities}
  defaultCity={defaultCity}
  smsTemplate={smsTemplate}
  cityCopy={cityCopy}
  defaultCopy={defaultCopy}
  variant="site"
  phone={PHONE}
  phoneDisplay={PHONE_DISPLAY}
>

  <!-- Hero — same treatment as the main-site homepage hero, offer card in place of the promo card -->
  <section class="px-3 sm:px-4 pt-3">
    <div class="relative overflow-hidden rounded-[2rem]" style="background-image:url('/photos/rodent.jpg');background-size:cover;background-position:center;">
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/25"></div>
      <div class="relative container-site py-14 md:py-24 grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <p class="inline-flex items-center gap-2 bg-white/15 backdrop-blur text-white text-sm font-semibold px-4 py-2 rounded-full mb-6">
            <span class="text-yellow-300">★★★★★</span> 5.0 on Google · Family owned since 2005
          </p>
          <p class="text-green-300 font-bold uppercase tracking-widest text-xs md:text-sm mb-4">Rodent Exclusion in <span data-city>{defaultCity}</span></p>
          <h1 class="h-display text-white">Get Your Home Rodent-Free. Keep It That Way.</h1>
          <p class="text-white/90 text-lg md:text-xl mt-6 max-w-xl leading-relaxed">
            Scratching in the attic? Droppings in the garage? Traps alone won't fix it — new rats
            keep coming in the same way. We find every entry point, seal your home shut, and
            remove the rodents already inside.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href={defaultSmsHref} data-sms class="btn-light !py-4 !px-8 text-lg"><Icon name="chat" class="w-5 h-5" />Text for a Free Inspection</a>
            <a href={`tel:${PHONE}`} class="btn-ghost-light !py-4 !px-8 text-lg"><Icon name="phone" class="w-5 h-5" />{PHONE_DISPLAY}</a>
          </div>
          <p class="text-white/75 text-sm font-semibold mt-5">Most texts answered within minutes · Mon–Fri 9am–5pm</p>
        </div>

        <div class="lg:col-span-5 lg:justify-self-end w-full max-w-md">
          <div class="bg-white rounded-3xl p-7 shadow-2xl">
            <p class="inline-block bg-yellow-300 text-brand-dark text-xs font-extrabold uppercase tracking-widest px-3 py-1 rounded-full mb-4">No charge · No obligation</p>
            <p class="text-3xl font-extrabold text-brand-dark leading-tight mb-2">Free Rodent Inspection</p>
            <p class="text-gray-600 mb-5">Attic, crawl space, garage and exterior. We show you every way they're getting in and give you a straight price to seal it.</p>
            <a href={defaultSmsHref} data-sms class="btn-primary w-full !py-4">Book My Free Inspection</a>
            <p class="text-xs text-gray-500 mt-3 text-center">Licensed &amp; insured in California</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="px-4 py-10 border-b border-gray-100">
    <div class="container-site grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div><p class="text-4xl font-extrabold text-brand-dark">{years}+</p><p class="text-sm text-gray-500 font-semibold">Years serving LA</p></div>
      <div><p class="text-4xl font-extrabold text-brand-dark">5.0 ★</p><p class="text-sm text-gray-500 font-semibold">Google rating</p></div>
      <div><p class="text-4xl font-extrabold text-brand-dark">60-Day</p><p class="text-sm text-gray-500 font-semibold">Trapping guarantee</p></div>
      <div><p class="text-4xl font-extrabold text-brand-dark">0</p><p class="text-sm text-gray-500 font-semibold">Poison inside your home</p></div>
    </div>
  </section>

  <!-- The exclusion argument -->
  <section class="py-20 px-4">
    <div class="container-site grid gap-12 lg:grid-cols-2 items-center">
      <div>
        <p class="eyebrow mb-3">The real fix</p>
        <h2 class="h-section mb-6">Why trapping alone doesn't work</h2>
        <p class="lead mb-5">
          Every rat you catch in the attic got there through an opening — and that opening is
          still there. Trap the ones inside without sealing the house, and the next rats follow
          the same scent trail right back in. That's why so many homeowners in
          <span data-city>{defaultCity}</span> are still hearing scratching months later.
        </p>
        <p class="lead mb-5" data-city-copy="localTexture">
          {defaultCopy.localTexture}
        </p>
        <p class="text-lg font-bold text-brand-dark leading-relaxed">
          Exclusion fixes the cause. We seal the home first, then trap what's left inside — so
          once they're gone, they stay gone.
        </p>
      </div>
      <img
        src="/photos/work-bait-station.jpg"
        alt="Lion Gate technician with a rodent bait station along a home's exterior wall"
        class="w-full h-80 lg:h-[520px] object-cover rounded-3xl"
        loading="lazy"
      />
    </div>
  </section>

  <!-- Common entry points -->
  <section class="py-20 px-4 bg-brand-light">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">What we look for</p>
        <h2 class="h-section">Where they're getting in</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {entryPoints.map((p) => (
          <div class="card p-5 flex items-center gap-4">
            <span class="w-12 h-12 rounded-2xl bg-brand-light text-brand-medium flex items-center justify-center flex-shrink-0"><Icon name={p.icon} /></span>
            <p class="font-semibold text-gray-700">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="py-20 px-4">
    <div class="container-site">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">Service details</p>
        <h2 class="h-section">What our exclusion service includes</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {included.map((item) => (
          <div class="card p-8">
            <div class="w-12 h-12 rounded-2xl bg-brand-light text-brand-medium flex items-center justify-center mb-4"><Icon name={item.icon} /></div>
            <h3 class="text-lg font-extrabold text-brand-dark mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>

      <!-- Guarantee. The fine print sits right here because the page has no links to the terms. -->
      <div class="rounded-3xl bg-brand-dark diagonal-stripe text-white p-8 md:p-10 mt-6 flex flex-col md:flex-row md:items-center gap-6">
        <span class="w-14 h-14 rounded-2xl bg-white text-brand-dark flex items-center justify-center flex-shrink-0"><Icon name="shield" class="w-7 h-7" /></span>
        <div>
          <p class="text-green-300 font-bold uppercase tracking-widest text-xs md:text-sm mb-2">Our 60-day guarantee</p>
          <h3 class="text-2xl md:text-3xl font-extrabold mb-3">We keep trapping until they're gone.</h3>
          <p class="text-green-100/85 leading-relaxed">
            For 60 days after we seal your home, we keep coming back to check and reset traps at no
            extra charge until rodent activity stops.
          </p>
          <p class="text-green-100/60 text-xs mt-3">Covers follow-up trapping inside the home during the 60 days after your exclusion work is complete.</p>
        </div>
      </div>
    </div>
  </section>

  <ProcessSteps heading="How our rodent exclusion works" steps={steps} />

  <!-- Reviews — same card treatment as the main site's ReviewCards, minus the outbound link -->
  <section class="py-20 px-4">
    <div class="container-site">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">5.0 ★ · 36 Google reviews</p>
        <h2 class="h-section">What your neighbors say</h2>
      </div>
      <div class="swipe-row md:grid md:grid-cols-3 md:gap-6">
        {reviews.map((review) => (
          <figure class="swipe-item card p-7 md:p-8 flex flex-col">
            <div class="text-yellow-400 text-xl mb-4" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote class="text-gray-700 leading-relaxed flex-1">“{review.text}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="w-10 h-10 rounded-full bg-brand-light flex items-center justify-center font-bold text-brand-dark">G</span>
              <span class="text-sm font-bold text-brand-dark">{review.source}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="md:hidden text-center text-xs font-semibold text-gray-500 mt-1">Swipe for more →</p>
      <p
        class="text-center text-gray-600 font-semibold mt-8"
        data-city-copy="serviceArea"
        hidden
      ></p>
    </div>
  </section>

  <!-- Final CTA — mirrors the main site's PreFooterCTA -->
  <section class="bg-brand-light py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="eyebrow mb-3">Free inspection</p>
      <h2 class="h-section mb-5">Seal them out for good.</h2>
      <p class="lead mb-8 max-w-2xl mx-auto">
        Free rodent inspection in <span data-city>{defaultCity}</span>. No charge, no obligation —
        we usually reply within minutes during business hours (Mon–Fri 9am–5pm).
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={defaultSmsHref} data-sms class="btn-primary-lg"><Icon name="chat" class="w-5 h-5" />Text for a Free Inspection</a>
        <a href={`tel:${PHONE}`} class="btn-outline !py-4 !px-8 text-lg">Call {PHONE_DISPLAY}</a>
      </div>
    </div>
  </section>

</LandingLayout>
