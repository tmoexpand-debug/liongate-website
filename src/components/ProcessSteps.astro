---
import { business } from '../data/site';

interface Props {
  heading?: string;
  steps?: { title: string; text: string }[];
}
const {
  heading = 'Our process is simple and effective',
  steps = [
    { title: 'Text or call us', text: `Reach us at ${business.phone}. We reply fast during business hours and get you a straight answer on price.` },
    { title: 'We inspect & treat', text: 'A licensed technician inspects your home, finds where pests are getting in, and treats the problem at the source.' },
    { title: 'Ongoing protection', text: 'Recurring visits keep pests out. If they come back between visits, so do we — free.' },
  ],
} = Astro.props;
---
<section class="py-20 px-4 bg-brand-dark diagonal-stripe text-white">
  <div class="container-site">
    <div class="text-center mb-14">
      <p class="text-green-300 font-bold uppercase tracking-widest text-xs md:text-sm mb-3">How it works</p>
      <h2 class="text-3xl md:text-5xl font-extrabold leading-tight">{heading}</h2>
    </div>
    <ol class="grid gap-8 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="bg-white/10 rounded-3xl p-8 border border-white/15">
          <span class="w-14 h-14 rounded-full bg-white text-brand-dark font-extrabold text-2xl flex items-center justify-center mb-6">{i + 1}</span>
          <h3 class="text-xl font-extrabold mb-3">{s.title}</h3>
          <p class="text-green-100/85 leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
