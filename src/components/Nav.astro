---
import Icon from './Icon.astro';
import { business, services, cities, cityHref, primaryCtaHref } from '../data/site';

const links = [
  { label: 'Pricing', href: '/pricing/' },
  { label: 'About', href: '/about/' },
  { label: 'Reviews', href: '/reviews/' },
  { label: 'Blog', href: '/blog/' },
];
const linkClass = 'whitespace-nowrap text-brand-body hover:text-brand-medium font-semibold text-[0.95rem] transition-colors';
---

<nav class="bg-white/95 backdrop-blur sticky top-0 z-50 border-b border-gray-200">
  <div class="container-site">
    <div class="flex items-center justify-between h-20 gap-6">
      <a href="/" class="flex items-center gap-3 flex-shrink-0" aria-label="Lion Gate Pest Control home">
        <img src="/logo-color.png" alt="Lion Gate Pest Control" class="h-14 w-auto" />
      </a>

      <!-- Desktop nav -->
      <div class="hidden xl:flex items-center gap-7">
        <div class="site-dropdown-parent relative py-2">
          <a href="/services/" class={`${linkClass} flex items-center gap-1`}>
            Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="site-dropdown">
            <div class="site-dropdown-inner">
              {services.map((s) => <a href={s.href}><span class="inline-flex items-center gap-2.5"><Icon name={s.icon} class="w-5 h-5 text-brand-medium" />{s.name}</span></a>)}
              <a href="/services/" class="!text-brand-medium">All services →</a>
              <a href="/common-pests/" class="!text-brand-medium">Common pests →</a>
            </div>
          </div>
        </div>

        <div class="site-dropdown-parent relative py-2">
          <a href="/service-areas/" class={`${linkClass} flex items-center gap-1`}>
            Service Areas
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="site-dropdown cols-2">
            <div class="site-dropdown-inner">
              {cities.map((c) => <a href={cityHref(c)}>{c.name}</a>)}
              <a href="/service-areas/" class="!text-brand-medium">All areas →</a>
            </div>
          </div>
        </div>

        {links.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
      </div>

      <div class="hidden xl:flex items-center gap-3 flex-shrink-0">
        <a href={primaryCtaHref} class="btn-primary text-sm">Protect My Home</a>
        <a href={business.phoneHref} class="btn-outline text-sm !py-2.5">
          {business.phone}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <!-- Mobile hamburger (+ CTA on tablets) -->
      <a href={primaryCtaHref} class="btn-primary text-sm hidden md:inline-flex xl:hidden ml-auto">Protect My Home</a>
      <button id="hamburger" class="xl:hidden text-brand-dark p-2" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg id="hamburger-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden xl:hidden border-t border-gray-200 bg-white max-h-[calc(100vh-5rem)] overflow-y-auto">
    <div class="px-4 py-4 space-y-1">
      <details class="border-b border-gray-100" open>
        <summary class="py-3 font-bold text-brand-dark cursor-pointer">Services</summary>
        <div class="pb-3 pl-3 space-y-1">
          {services.map((s) => <a href={s.href} class="flex items-center gap-2.5 py-2 font-semibold"><Icon name={s.icon} class="w-5 h-5 text-brand-medium" />{s.name}</a>)}
          <a href="/services/" class="block py-2 font-semibold text-brand-medium">All services →</a>
          <a href="/common-pests/" class="block py-2 font-semibold text-brand-medium">Common pests →</a>
        </div>
      </details>
      <details class="border-b border-gray-100">
        <summary class="py-3 font-bold text-brand-dark cursor-pointer">Service Areas</summary>
        <div class="pb-3 pl-3 grid grid-cols-2 gap-x-2">
          {cities.map((c) => <a href={cityHref(c)} class="block py-2 font-semibold text-sm">{c.name}</a>)}
          <a href="/service-areas/" class="block py-2 font-semibold text-sm text-brand-medium">All areas →</a>
        </div>
      </details>
      {[...links, { label: 'FAQ', href: '/faq/' }, { label: 'Contact', href: '/contact/' }].map((l) => (
        <a href={l.href} class="block py-3 font-bold text-brand-dark border-b border-gray-100">{l.label}</a>
      ))}
      <div class="pt-4 grid gap-3">
        <a href={primaryCtaHref} class="btn-primary w-full">Protect My Home</a>
        <a href={business.phoneHref} class="btn-outline w-full">Call {business.phone}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  hamburger?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    hamburgerIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    hamburger.setAttribute('aria-expanded', String(open));
  });
</script>
