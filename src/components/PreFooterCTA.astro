---
import { business, promo, primaryCtaHref } from '../data/site';
---
<section class="bg-brand-light py-20 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <p class="eyebrow mb-3">Have questions?</p>
    <h2 class="h-section mb-5">Start your pest-free home today.</h2>
    <p class="lead mb-8 max-w-2xl mx-auto">
      Text or call — we usually reply within minutes during business hours ({business.hours}).
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href={primaryCtaHref} class="btn-primary-lg">
        {promo.active ? `Text "${promo.code}" — ${promo.headline}` : 'Text Us for a Free Quote'}
      </a>
      <a href={business.phoneHref} class="btn-outline !py-4 !px-8 text-lg">Call {business.phone}</a>
    </div>
    {promo.active && <p class="text-gray-500 text-sm mt-4">{promo.terms}</p>}
  </div>
</section>
