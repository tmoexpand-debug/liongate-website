---
import { business, featuredReviews } from '../data/site';

interface Props { heading?: string }
const { heading = 'What our clients say' } = Astro.props;
---
<section class="py-20 px-4">
  <div class="container-site">
    <div class="text-center mb-12">
      <p class="eyebrow mb-3">{business.rating} ★ · {business.reviewCount} Google reviews</p>
      <h2 class="h-section">{heading}</h2>
    </div>
    <div class="swipe-row md:grid md:grid-cols-3 md:gap-6">
      {featuredReviews.map((text) => (
        <figure class="swipe-item card p-7 md:p-8 flex flex-col">
          <div class="text-yellow-400 text-xl mb-4" aria-label="5 out of 5 stars">★★★★★</div>
          <blockquote class="text-gray-700 leading-relaxed flex-1">“{text}”</blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <span class="w-10 h-10 rounded-full bg-brand-light flex items-center justify-center font-bold text-brand-dark">G</span>
            <span class="text-sm font-bold text-brand-dark">Verified Google Review</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="md:hidden text-center text-xs font-semibold text-gray-500 mt-1">Swipe for more →</p>
    <div class="text-center mt-8 md:mt-10">
      <a href="/reviews/" class="btn-outline">Read more reviews</a>
    </div>
  </div>
</section>
