---
import { services } from '../data/site';

interface Props {
  /** Hide the card(s) for the page you're already on */
  exclude?: string | string[];
  heading?: string;
  eyebrow?: string;
  /** Appended to card titles, e.g. "in Burbank" */
  suffix?: string;
}
const { exclude, heading = 'Explore our services', eyebrow = 'What we do', suffix } = Astro.props;
const excluded = ([] as string[]).concat(exclude ?? []);
const list = services.filter((s) => !excluded.includes(s.slug));
const cols = list.length >= 5 ? 'lg:grid-cols-3 xl:grid-cols-5' : list.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---
<section class="py-20 px-4">
  <div class="container-site">
    <div class="text-center mb-12">
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h2 class="h-section">{heading}</h2>
    </div>
    <div class={`swipe-row sm:grid sm:gap-6 sm:grid-cols-2 ${cols}`}>
      {list.map((s) => (
        <a href={s.href} class="swipe-item group card overflow-hidden flex flex-col hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
          <div class="p-6 flex flex-col flex-1">
            <h3 class="text-xl font-extrabold text-brand-dark mb-2">{s.name}{suffix && <span class="sr-only"> {suffix}</span>}</h3>
            <p class="text-gray-600 text-sm leading-relaxed flex-1">{s.summary}</p>
            <div class="mt-5 flex items-center justify-between gap-3">
              <span class="text-sm font-bold text-brand-medium whitespace-nowrap">
                {s.price.amount ? `Starting at ${s.price.amount}${s.price.unit}` : s.price.label}
              </span>
              <span class="w-9 h-9 flex-shrink-0 rounded-full bg-brand-light text-brand-dark flex items-center justify-center group-hover:bg-brand-dark group-hover:text-white transition-colors" aria-hidden="true">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <p class="sm:hidden text-center text-xs font-semibold text-gray-500 mt-1">Swipe for more →</p>
  </div>
</section>
