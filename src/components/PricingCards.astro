---
import { services, promo, smsHref } from '../data/site';

interface Props {
  heading?: string;
  /** Use h1 when this is the main heading of the page */
  asH1?: boolean;
}
const { heading = 'Our prices', asH1 = false } = Astro.props;
const Tag = asH1 ? 'h1' : 'h2';
---
<section class="py-20 px-4 bg-brand-light">
  <div class="container-site">
    <div class="text-center mb-12">
      <p class="eyebrow mb-3">Honest starting prices</p>
      <Tag class={asH1 ? 'h-display text-brand-dark' : 'h-section'}>{heading}</Tag>
      <p class="lead mt-4 max-w-2xl mx-auto">Every home is different. Your exact price depends on the size of your property and the pest problem — we'll confirm it before any work starts.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <div class={`card p-8 flex flex-col ${i === 0 ? 'ring-2 ring-brand-medium relative' : ''}`}>
          {i === 0 && <span class="absolute -top-3 left-8 bg-brand-medium text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">Most popular</span>}
          <h3 class="text-lg font-extrabold text-brand-dark">{s.name}</h3>
          <p class="text-sm text-gray-500 mb-6">{s.tagline}</p>
          <p class="text-xs font-bold uppercase tracking-wider text-gray-500">{s.price.amount ? s.price.label : 'Starts with a'}</p>
          {s.price.amount
            ? <p class="text-5xl font-extrabold text-brand-dark mb-1">{s.price.amount}<span class="text-xl font-bold text-gray-500">{s.price.unit}</span></p>
            : <p class="text-5xl font-extrabold text-brand-dark mb-1">Free<span class="block text-base font-bold text-gray-500 mt-1">inspection</span></p>}
          <p class="text-sm text-gray-500 mb-6">{s.price.note}</p>
          <ul class="space-y-2 text-sm mb-8 flex-1">
            {s.features.map((f) => <li class="flex gap-2"><span class="text-brand-medium font-bold">✓</span>{f}</li>)}
          </ul>
          <a href={smsHref(promo.active && s.slug === 'pest-control' ? promo.code : `Hi, I'd like a quote for ${s.name.toLowerCase()}`)} class="btn-primary w-full">
            {s.price.amount ? 'Get Started' : 'Book Inspection'}
          </a>
          <a href={s.href} class="text-center text-sm font-semibold text-brand-medium mt-3 hover:text-brand-dark">Learn more →</a>
        </div>
      ))}
    </div>
    {promo.active && (
      <p class="text-center text-sm text-gray-600 mt-8">
        <strong class="text-brand-dark">{promo.eyebrow}:</strong> {promo.headline} — text <strong>{promo.code}</strong>. {promo.terms}
      </p>
    )}
  </div>
</section>
